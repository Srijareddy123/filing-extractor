# Copy to .env (git-ignored) and fill in.

# SEC fair access: a User-Agent with your name and email. Only needed to re-fetch exhibits.
SEC_USER_AGENT=Your Name your.email@your-domain.example

# Only needed for the prompted-LLM baseline on new passages. Leave empty for demo mode.
ANTHROPIC_API_KEY=
# FX_LLM_MODEL=claude-haiku-4-5

# Which extractor the API uses by default: rules, llm or lora.
# FX_MODEL=rules
# FX_LORA_ADAPTER=outputs/lora-qwen2.5-0.5b
